# Sao chép thành .env để ghi đè cấu hình YAML khi cần. Bỏ dấu # ở dòng muốn dùng.
# Lưu ý: giá trị ở đây được ưu tiên hơn preset, nên chỉ đặt những gì thực sự muốn ghi đè.

# APP_NAME=Conveyor Object Counter
# DATA_OUTPUT=outputs
# DATA_MODEL=models

# INPUT_PATH=inputs/videos/snack-converyo-belt.mp4
# INPUT_VID_STRIDE=1
# INPUT_DISPLAY=true
# INPUT_REALTIME=true

# DETECTOR_TYPE=snack
# DETECTOR_CONF_THRESHOLD=0.1
# DETECTOR_IOU_THRESHOLD=0.7
# DETECTOR_MAX_DET=100
# DETECTOR_IMGSZ=640
# DETECTOR_DEVICE=null
# DETECTOR_CLASSES=null

# SAVER_SAVE_IMAGES=false
# SAVER_SAVE_VIDEOS=false
# SAVER_SAVE_DETECTIONS=false
# SAVER_SAVE_CROPS=false

# TRACKER_CONFIG=config/bytetrack.yaml
